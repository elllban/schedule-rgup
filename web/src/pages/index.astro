---
import scheduleJson from '../data/schedule.json';
import '../styles/global.css';

type EventInfo = {
  id: string;
  start: string;
  end: string;
  lessonType: string;
  discipline: string | null;
  teacher: string | null;
  room: string | null;
  onlineLink: string | null;
};
type GroupData = { id: string; course: number | null; events: EventInfo[] };
type ScheduleData = {
  meta: {
    academicYear: string;
    semester: string;
    period: { from: string; to: string };
    parityAnchor: string;
    sourceUrl: string;
  };
  groups: GroupData[];
  occurrences: { groupId: string; date: string; start: string; end: string; eventId: string }[];
};

const schedule = scheduleJson as ScheduleData;

// Собираем плоский словарь событий, чтобы по eventId в occurrences
// доставать дисциплину, преподавателя, аудиторию и т.д.
const eventsMap: Record<string, Omit<EventInfo, 'id'>> = {};
for (const group of schedule.groups) {
  for (const event of group.events) {
    eventsMap[event.id] = {
      start: event.start,
      end: event.end,
      lessonType: event.lessonType,
      discipline: event.discipline,
      teacher: event.teacher,
      room: event.room,
      onlineLink: event.onlineLink,
    };
  }
}

const payload = {
  meta: schedule.meta,
  groups: schedule.groups.map((group) => ({ id: group.id, course: group.course })),
  events: eventsMap,
  occurrences: schedule.occurrences,
};

// Экранируем `<`, чтобы JSON не закрыл тег <script>.
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Расписание ЗСФ РГУП (неофициально)</title>
    <meta
      name="description"
      content="Неофициальное расписание занятий Западно-Сибирского филиала РГУП"
    />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-4">
        <h1 class="text-xl font-bold">Расписание занятий</h1>
        <p class="text-sm text-gray-500">
          Западно-Сибирский филиал РГУП · {schedule.meta.academicYear},{' '}
          {schedule.meta.semester} семестр · неофициальный проект
        </p>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-6">
      <div class="mb-4 flex items-center gap-2 text-sm">
        <label class="flex items-center gap-2">
          <span class="text-gray-600">Группа</span>
          <select
            id="group-select"
            class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium focus:border-blue-500 focus:outline-none"
          >
            {schedule.groups.map((group) => (
              <option value={group.id}>
                {group.id}{group.course != null ? ` · ${group.course} курс` : ''}
              </option>
            ))}
          </select>
        </label>
      </div>

      <div id="desktop" class="hidden md:block">
        <div class="mb-4 flex items-center gap-2">
          <button
            id="week-prev"
            class="shrink-0 rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm"
            aria-label="Предыдущая неделя">‹</button
          >
          <div id="week-strip" class="flex flex-1 gap-2 overflow-x-auto py-1"></div>
          <button
            id="week-next"
            class="shrink-0 rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm"
            aria-label="Следующая неделя">›</button
          >
        </div>
        <div id="desktop-grid"></div>
      </div>

      <div id="mobile" class="md:hidden">
        <div class="mb-3 flex items-center justify-between gap-2">
          <button
            id="mobile-prev"
            class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm"
            aria-label="Предыдущая неделя">‹</button
          >
          <div id="mobile-label" class="text-base font-semibold"></div>
          <button
            id="mobile-next"
            class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm"
            aria-label="Следующая неделя">›</button
          >
        </div>
        <div id="mobile-days" class="mb-4 grid grid-cols-7 gap-1"></div>
        <div id="mobile-schedule"></div>
      </div>

      <div id="period-banner" hidden class="mb-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"></div>
    </main>

    <footer class="border-t border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-6 text-sm text-gray-500">
        <p class="mb-1">
          Неофициальный проект. Расписание может содержать неточности и не является
          официальным сервисом вуза.
        </p>
        <p>
          Первоисточник:
          <a
            href={schedule.meta.sourceUrl}
            class="text-blue-600 underline"
            target="_blank"
            rel="noopener">сайт ЗСФ РГУП</a
          >
        </p>
      </div>
    </footer>

    <script type="application/json" id="schedule-data" set:html={payloadJson}></script>

    <script>
      type EventInfo = {
        start: string;
        end: string;
        lessonType: string;
        discipline: string | null;
        teacher: string | null;
        room: string | null;
        onlineLink: string | null;
      };
      type Occurrence = { groupId: string; date: string; start: string; end: string; eventId: string };
      type Payload = {
        meta: { period: { from: string; to: string }; parityAnchor: string };
        groups: { id: string; course: number | null }[];
        events: Record<string, EventInfo>;
        occurrences: Occurrence[];
      };

      const dataElement = document.getElementById('schedule-data');
      const payload = JSON.parse(dataElement?.textContent ?? '{}') as Payload;

      const WEEKDAYS_SHORT = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
      const WEEKDAYS_FULL = [
        'Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота', 'Воскресенье',
      ];
      const MONTHS_NOM = [
        'январь', 'февраль', 'март', 'апрель', 'май', 'июнь',
        'июль', 'август', 'сентябрь', 'октябрь', 'ноябрь', 'декабрь',
      ];
      const MONTHS_GEN = [
        'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
        'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря',
      ];
      const LESSON_TYPE_LABELS: Record<string, string> = {
        lecture: 'Лекция', seminar: 'Семинар', other: 'Другое',
      };
      const TYPE_BADGE: Record<string, string> = {
        lecture: 'bg-blue-100 text-blue-700',
        seminar: 'bg-emerald-100 text-emerald-700',
        other: 'bg-gray-100 text-gray-600',
      };

      const groupSelect = document.getElementById('group-select') as HTMLSelectElement;
      const weekPrev = document.getElementById('week-prev') as HTMLButtonElement;
      const weekNext = document.getElementById('week-next') as HTMLButtonElement;
      const weekStrip = document.getElementById('week-strip') as HTMLElement;
      const desktopGrid = document.getElementById('desktop-grid') as HTMLElement;
      const mobilePrev = document.getElementById('mobile-prev') as HTMLButtonElement;
      const mobileNext = document.getElementById('mobile-next') as HTMLButtonElement;
      const mobileLabel = document.getElementById('mobile-label') as HTMLElement;
      const mobileDays = document.getElementById('mobile-days') as HTMLElement;
      const mobileSchedule = document.getElementById('mobile-schedule') as HTMLElement;
      const periodBanner = document.getElementById('period-banner') as HTMLElement;

      function parseDate(value: string): Date {
        const [year, month, day] = value.split('-').map(Number);
        return new Date(year, month - 1, day);
      }
      function toISODate(value: Date): string {
        const year = value.getFullYear();
        const month = String(value.getMonth() + 1).padStart(2, '0');
        const day = String(value.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }
      function startOfDay(value: Date): Date {
        const result = new Date(value);
        result.setHours(0, 0, 0, 0);
        return result;
      }
      function addDays(value: Date, amount: number): Date {
        const result = new Date(value);
        result.setDate(result.getDate() + amount);
        return result;
      }
      function startOfWeek(value: Date): Date {
        const result = startOfDay(value);
        result.setDate(result.getDate() - ((result.getDay() + 6) % 7));
        return result;
      }
      function formatShortDate(value: Date): string {
        const day = String(value.getDate()).padStart(2, '0');
        const month = String(value.getMonth() + 1).padStart(2, '0');
        return `${day}.${month}`;
      }
      function formatFullDate(value: Date): string {
        const weekday = WEEKDAYS_FULL[(value.getDay() + 6) % 7];
        return `${weekday}, ${value.getDate()} ${MONTHS_GEN[value.getMonth()]} ${value.getFullYear()}`;
      }
      function weekParity(monday: Date): 'чётная' | 'нечётная' {
        const days = Math.round((monday.getTime() - parityAnchor.getTime()) / 86400000);
        const weeks = Math.floor(days / 7);
        return weeks % 2 === 0 ? 'чётная' : 'нечётная';
      }
      function escapeHtml(value: string): string {
        const map: Record<string, string> = {
          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
        };
        return value.replace(/[&<>"']/g, (char) => map[char]);
      }

      const occurrencesByGroupDate = new Map<string, Map<string, Occurrence[]>>();
      for (const occurrence of payload.occurrences) {
        let byDate = occurrencesByGroupDate.get(occurrence.groupId);
        if (!byDate) {
          byDate = new Map();
          occurrencesByGroupDate.set(occurrence.groupId, byDate);
        }
        let list = byDate.get(occurrence.date);
        if (!list) {
          list = [];
          byDate.set(occurrence.date, list);
        }
        list.push(occurrence);
      }
      for (const byDate of occurrencesByGroupDate.values()) {
        for (const list of byDate.values()) {
          list.sort((a, b) => a.start.localeCompare(b.start) || a.end.localeCompare(b.end));
        }
      }

      function getOccurrences(groupId: string, date: string): Occurrence[] {
        return occurrencesByGroupDate.get(groupId)?.get(date) ?? [];
      }

      function renderLesson(occurrence: Occurrence): string {
        const event = payload.events[occurrence.eventId];
        if (!event) return '';
        const typeLabel = LESSON_TYPE_LABELS[event.lessonType] ?? event.lessonType;
        const badge = TYPE_BADGE[event.lessonType] ?? 'bg-gray-100 text-gray-600';
        return `
          <div class="rounded-lg border border-gray-200 bg-white p-3 shadow-sm">
            <div class="text-xs font-medium text-gray-500">${escapeHtml(occurrence.start)}–${escapeHtml(occurrence.end)}</div>
            <div class="mt-0.5 font-semibold text-gray-900">${escapeHtml(event.discipline ?? '—')}</div>
            ${event.teacher ? `<div class="mt-0.5 text-sm text-gray-600">${escapeHtml(event.teacher)}</div>` : ''}
            <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-gray-600">
              <span class="rounded px-1.5 py-0.5 font-medium ${badge}">${escapeHtml(typeLabel)}</span>
              ${event.room ? `<span>ауд. ${escapeHtml(event.room)}</span>` : ''}
              ${event.onlineLink
                ? `<a href="${escapeHtml(event.onlineLink)}" target="_blank" rel="noopener" class="underline hover:text-blue-600">онлайн</a>`
                : ''}
            </div>
          </div>`;
      }

      function weekList(): Date[] {
        const first = startOfWeek(periodFrom);
        const result: Date[] = [];
        for (let monday = new Date(first); monday <= periodTo; monday = addDays(monday, 7)) {
          result.push(new Date(monday));
        }
        return result;
      }

      function renderWeekStrip(): string {
        const currentIso = toISODate(weekMonday);
        return weekList()
          .map((monday) => {
            const active = toISODate(monday) === currentIso;
            const cls = active
              ? 'border-blue-600 bg-blue-600 text-white'
              : 'border-gray-300 bg-white text-gray-600 hover:bg-gray-100';
            return `<button
              type="button"
              data-week="${toISODate(monday)}"
              class="week-btn whitespace-nowrap rounded-md border px-3 py-1.5 text-sm font-medium ${cls}"
            >${formatShortDate(monday)} · ${weekParity(monday)}</button>`;
          })
          .join('');
      }

      function renderWeekGrid(): string {
        const columns: string[] = [];
        for (let i = 0; i < 6; i += 1) {
          const day = addDays(weekMonday, i);
          const iso = toISODate(day);
          const isToday = iso === toISODate(today);
          const items =
            getOccurrences(selectedGroupId, iso).map(renderLesson).join('') ||
            '<div class="py-4 text-center text-xs text-gray-400">—</div>';
          columns.push(`
            <div class="flex min-w-[190px] flex-1 flex-col gap-2">
              <div class="px-2 py-1">
                <div class="text-sm font-semibold ${isToday ? 'text-blue-600' : 'text-gray-700'}">${WEEKDAYS_FULL[i]}</div>
                <div class="text-xs text-gray-500">${formatShortDate(day)}</div>
              </div>
              ${items}
            </div>`);
        }
        return `<div class="flex gap-4 overflow-x-auto pb-2">${columns.join('')}</div>`;
      }

      function renderMobileDays(): string {
        const todayIso = toISODate(today);
        const selectedIso = toISODate(selectedDay);
        const cells: string[] = [];
        for (let i = 0; i < 7; i += 1) {
          const day = addDays(weekMonday, i);
          const iso = toISODate(day);
          const isSelected = iso === selectedIso;
          const isToday = iso === todayIso;
          const cls = isSelected
            ? 'border-blue-600 bg-blue-600 text-white'
            : 'border-gray-300 bg-white text-gray-700';
          const numberCls = isSelected ? 'text-white' : isToday ? 'text-blue-600' : 'text-gray-800';
          cells.push(`
            <button
              type="button"
              data-day="${iso}"
              class="day-btn flex flex-col items-center rounded-md border py-1.5 ${cls}"
            >
              <span class="text-[11px] leading-none ${isSelected ? 'text-blue-100' : 'text-gray-500'}">${WEEKDAYS_SHORT[i]}</span>
              <span class="mt-1 text-sm font-semibold ${numberCls}">${day.getDate()}</span>
            </button>`);
        }
        return cells.join('');
      }

      function renderMobileSchedule(): string {
        const items = getOccurrences(selectedGroupId, toISODate(selectedDay)).map(renderLesson).join('');
        return items || '<div class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-sm text-gray-500">Нет занятий</div>';
      }

      function render(): void {
        weekStrip.innerHTML = renderWeekStrip();
        desktopGrid.innerHTML = renderWeekGrid();

        mobileLabel.textContent = `${MONTHS_NOM[weekMonday.getMonth()]} · ${formatShortDate(weekMonday)} – ${formatShortDate(addDays(weekMonday, 6))}`;
        mobileDays.innerHTML = renderMobileDays();
        mobileSchedule.innerHTML = renderMobileSchedule();

        const outOfPeriod = weekMonday < startOfWeek(periodFrom) || weekMonday > periodTo;
        periodBanner.hidden = !outOfPeriod;
        if (outOfPeriod) {
          periodBanner.textContent = `Дата вне периода расписания (${formatFullDate(periodFrom)} – ${formatFullDate(periodTo)}).`;
        }

        const active = weekStrip.querySelector(`.week-btn[data-week="${toISODate(weekMonday)}"]`);
        active?.scrollIntoView({ inline: 'center', block: 'nearest' });
      }

      function gotoWeek(monday: Date): void {
        weekMonday = new Date(monday);
        const todayIso = toISODate(today);
        const mondayIso = toISODate(weekMonday);
        const sundayIso = toISODate(addDays(weekMonday, 6));
        selectedDay = todayIso >= mondayIso && todayIso <= sundayIso ? today : new Date(weekMonday);
        render();
      }

      const periodFrom = parseDate(payload.meta.period.from);
      const periodTo = parseDate(payload.meta.period.to);
      const parityAnchor = parseDate(payload.meta.parityAnchor);
      const today = startOfDay(new Date());
      let selectedGroupId = payload.groups[0]?.id ?? '';
      const inPeriod = today >= periodFrom && today <= periodTo;
      let weekMonday = inPeriod ? startOfWeek(today) : startOfWeek(periodFrom);
      let selectedDay = inPeriod ? today : new Date(weekMonday);

      groupSelect.addEventListener('change', () => {
        selectedGroupId = groupSelect.value;
        render();
      });
      weekPrev.addEventListener('click', () => gotoWeek(addDays(weekMonday, -7)));
      weekNext.addEventListener('click', () => gotoWeek(addDays(weekMonday, 7)));
      weekStrip.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest('.week-btn') as HTMLElement | null;
        if (button?.dataset.week) {
          gotoWeek(parseDate(button.dataset.week));
        }
      });
      mobilePrev.addEventListener('click', () => gotoWeek(addDays(weekMonday, -7)));
      mobileNext.addEventListener('click', () => gotoWeek(addDays(weekMonday, 7)));
      mobileDays.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest('.day-btn') as HTMLElement | null;
        if (button?.dataset.day) {
          selectedDay = parseDate(button.dataset.day);
          render();
        }
      });

      render();
    </script>
  </body>
</html>
